{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flisbao/mosaic/schema/protocol.schema.json",
  "title": "mosaic widget snapshot (protocolo v1)",
  "description": "Saída JSON do comando `snapshot` de um widget. Campos desconhecidos são ignorados pelo painel (aviso no `mosaic check`).",
  "type": "object",
  "required": ["summary"],
  "properties": {
    "protocol": { "type": "integer", "minimum": 1, "default": 1 },
    "summary": { "$ref": "#/$defs/summary" },
    "detail": { "$ref": "#/$defs/detail" },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "alerts": { "type": "array", "items": { "$ref": "#/$defs/alert" } },
    "mini": { "$ref": "#/$defs/mini" }
  },
  "$defs": {
    "tone": {
      "enum": ["normal", "muted", "ok", "warn", "danger", "current"],
      "default": "normal"
    },
    "flag": { "enum": ["updated", "attention"] },
    "mini": {
      "type": "object",
      "required": ["value", "text"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 8 },
        "text": { "type": "string", "minLength": 1, "maxLength": 24 },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "text": { "type": "string", "maxLength": 500 },
    "widgetLine": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "tone": { "$ref": "#/$defs/tone" },
        "flag": { "$ref": "#/$defs/flag" }
      }
    },
    "tag": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "row": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "time": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "tags": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/tag" } },
        "tone": { "$ref": "#/$defs/tone" },
        "flag": { "$ref": "#/$defs/flag" }
      }
    },
    "statItem": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "column": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "align": { "enum": ["left", "right"], "default": "left" }
      }
    },
    "cell": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "$ref": "#/$defs/text" },
            "tone": { "$ref": "#/$defs/tone" },
            "flag": { "$ref": "#/$defs/flag" }
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "lines"],
          "properties": {
            "type": { "const": "lines" },
            "lines": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/widgetLine" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "rows"],
          "properties": {
            "type": { "const": "rows" },
            "rows": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/row" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "stat" },
            "items": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/statItem" } },
            "hint": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "required": ["type", "columns", "rows"],
          "properties": {
            "type": { "const": "table" },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "$ref": "#/$defs/column" }
            },
            "rows": {
              "type": "array",
              "maxItems": 200,
              "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
            }
          }
        }
      ]
    },
    "blocks": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/block" } },
    "summary": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "blocks": { "$ref": "#/$defs/blocks" }
      }
    },
    "detailItem": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "$ref": "#/$defs/text" },
        "flag": { "$ref": "#/$defs/flag" },
        "meta": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["heading"],
      "properties": {
        "heading": { "$ref": "#/$defs/text" },
        "blocks": { "$ref": "#/$defs/blocks" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/detailItem" } }
      }
    },
    "detail": {
      "type": "object",
      "properties": {
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "applies_to": { "enum": ["widget", "item"], "default": "widget" },
        "params": {}
      }
    },
    "alert": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "$ref": "#/$defs/text" },
        "body": { "$ref": "#/$defs/text" },
        "level": { "enum": ["info", "warn"], "default": "info" }
      }
    }
  }
}
